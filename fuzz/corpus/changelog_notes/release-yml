changelog:
  exclude:
    labels:
      - ignore-for-release
    authors:
      - octocat
      - dependabot[bot]
  categories:
    - title: Breaking Changes
      labels:
        - Semver-Major
        - breaking-change
    - title: Exciting New Features
      labels:
        - Semver-Minor
        - enhancement
    - title: Other Changes
      labels:
        - "*"
