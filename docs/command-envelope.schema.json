{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p4suta.github.io/release-glz/schema/command-v2.json",
  "title": "release-glz Command Envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ok", "command", "result", "diagnostics", "next_actions"],
  "properties": {
    "schema": { "const": "command/v2" },
    "ok": { "type": "boolean" },
    "command": { "type": "string", "minLength": 1 },
    "result": { "type": ["object", "array", "string", "number", "boolean", "null"] },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "next_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/nextAction" }
    }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "level", "message", "detail"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "level": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string" },
        "detail": { "type": ["string", "null"] }
      }
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "description"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    }
  }
}
