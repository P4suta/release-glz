{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/P4suta/release-glz/v1.0.0/docs/command-envelope.schema.json",
  "title": "release-glz Command Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ok", "command", "result", "diagnostics", "next_actions"],
  "properties": {
    "schema": { "const": "command/v1" },
    "ok": { "type": "boolean" },
    "command": { "type": "string", "minLength": 1 },
    "result": { "type": ["object", "array", "string", "number", "boolean", "null"] },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "next_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/nextAction" }
    }
  },
  "if": { "properties": { "ok": { "const": true } } },
  "then": {
    "properties": {
      "result": { "not": { "type": "null" } },
      "diagnostics": { "items": { "properties": { "level": { "enum": ["info", "warning"] } } } }
    }
  },
  "else": {
    "properties": {
      "diagnostics": { "contains": { "properties": { "level": { "const": "error" } } } }
    },
    "if": { "properties": { "result": { "type": "null" } } },
    "then": {
      "properties": {
        "diagnostics": {
          "items": {
            "if": { "properties": { "level": { "const": "error" } } },
            "then": { "properties": { "code": { "$ref": "#/$defs/failureCode" } } }
          }
        }
      }
    }
  },
  "$defs": {
    "failureCode": {
      "anyOf": [{ "$ref": "#/$defs/failureClass" }, { "$ref": "#/$defs/refusalReason" }]
    },
    "failureClass": {
      "enum": [
        "internal_failure",
        "usage_or_config",
        "policy_or_approval",
        "immutable_state_conflict",
        "temporary_external_failure",
        "hook_failure",
        "partial_release"
      ]
    },
    "refusalReason": {
      "enum": [
        "config_missing", "config_schema_unsupported", "config_table_invalid", "manifest_changed",
        "package_name_invalid", "path_not_relative", "path_outside_repository", "git_ref_unsafe",
        "git_ref_prefix_unsafe", "hook_id_unsafe", "hook_id_reserved", "hook_argv_invalid",
        "hook_timeout_out_of_range", "hook_env_invalid", "hook_env_protected", "credential_env_invalid",
        "registry_repository_invalid", "url_credentials", "url_not_hierarchical", "url_query_or_fragment",
        "url_transport_untrusted", "approval_environment_invalid", "approval_mode_fixed",
        "approval_fallback_unsupported", "manual_ref_kind_unsupported", "manual_ref_duplicate",
        "api_exception_duplicate", "api_exception_reason_missing", "api_exception_expiry_invalid",
        "github_repository_invalid", "github_token_missing", "github_environment_empty",
        "github_default_branch_missing", "release_pr_marker_mismatch", "release_pr_head_unverified",
        "release_pr_intent_conflict", "release_pr_changed", "candidate_run_from_another_push",
        "candidate_run_promotes_itself", "candidate_run_event_unsupported", "approval_github_token_missing",
        "actions_artifact_identity_invalid", "actions_run_id_invalid", "actions_artifact_expired",
        "actions_artifact_mismatch", "actions_run_mismatch", "github_tag_target_not_commit",
        "github_tag_object_unsupported", "github_tag_creation_unexpected", "github_release_tag_ambiguous",
        "release_asset_draft_required", "release_asset_name_unsafe", "release_asset_media_type_invalid",
        "release_upload_url_malformed", "release_upload_url_untrusted", "release_upload_url_mismatch",
        "release_asset_upload_unexpected", "release_asset_on_published_release", "release_asset_uploaded",
        "release_asset_missing", "release_asset_duplicate", "release_asset_id_missing",
        "candidate_not_directory", "candidate_destination_exists", "candidate_source_commit_invalid",
        "candidate_tag_unsafe", "candidate_tag_version_mismatch", "candidate_release_notes_invalid",
        "manual_refs_empty", "hook_id_duplicate", "notify_hook_id_invalid", "notify_hooks_mismatch",
        "candidate_docs_policy_mismatch", "candidate_interface_too_large", "candidate_schema_unsupported",
        "candidate_manifest_invalid", "candidate_file_not_regular", "candidate_file_too_large",
        "candidate_artifact_path_unexpected", "candidate_checksum_malformed", "candidate_checksum_mismatch",
        "candidate_inventory_mismatch", "candidate_semantic_checksum_mismatch",
        "candidate_intent_digest_mismatch", "candidate_digest_mismatch", "candidate_hook_evidence_invalid",
        "candidate_hook_failed", "candidate_hook_evidence_mismatch", "candidate_sidecar_producer_undeclared",
        "candidate_sidecars_too_many", "candidate_sidecar_path_invalid", "candidate_sidecars_too_large",
        "candidate_sidecar_release_disabled", "candidate_sidecar_private_upload_forbidden",
        "candidate_sidecar_name_duplicate", "candidate_evidence_policy_mismatch", "candidate_signature_missing",
        "sidecar_hook_id_unsafe", "sidecar_name_unsafe", "sidecar_media_type_invalid",
        "candidate_source_mismatch", "candidate_policy_differs", "registry_credential_missing",
        "oidc_url_untrusted", "oidc_token_unverified", "oidc_claims_mismatch", "oidc_token_outside_validity",
        "version_number_exhausted", "prerelease_train_backward", "explicit_version_refused",
        "version_not_after_published", "changelog_notes_layout_invalid", "changelog_note_invalid",
        "gleam_compiler_unsupported", "gleam_repository_invalid", "release_pr_marker_not_trailing",
        "workflow_input_unsafe", "action_sha_invalid", "workflow_modified", "registry_release_invalid",
        "registry_release_not_visible", "archive_limit_exceeded", "archive_path_unsafe",
        "archive_entry_not_regular", "archive_entry_duplicate", "archive_extension_header_invalid",
        "hex_inner_checksum_mismatch", "hook_snapshot_modified", "hook_timed_out", "hook_reported_failure",
        "hook_observation_failed", "hook_output_limit_exceeded", "hook_output_invalid",
        "sidecar_artifacts_invalid", "sidecar_artifacts_limit_exceeded", "hook_snapshot_entry_not_regular",
        "source_commit_unresolved", "gleam_compiler_mismatch", "version_lowering_forbidden",
        "manifest_version_behind_published", "baseline_ref_unresolved", "api_exception_expired",
        "baseline_not_found", "release_file_outside_repository", "registry_package_invalid",
        "registry_redirect_cross_origin", "registry_redirect_limit_exceeded",
        "registry_redirect_location_invalid", "registry_response_too_large", "release_asset_unfinished",
        "approval_request_incomplete", "approval_release_pr_missing"
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "level", "message", "detail"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "level": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string" },
        "detail": { "type": ["string", "null"] }
      }
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "command", "description"],
      "properties": {
        "argv": {
          "type": "array",
          "items": { "type": "string" }
        },
        "command": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    }
  }
}
